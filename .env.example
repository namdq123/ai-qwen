QWEN_VL_MODEL=Qwen/Qwen3-VL-8B-Instruct
QWEN_VL_DTYPE=bfloat16
QWEN_DEVICE=cuda
QWEN_VL_MAX_NEW_TOKENS=2048
# Visual tokens ~= max_pixels / (28*28). 1280 patches fits a 1024 canvas.
QWEN_VL_MIN_PIXELS=3136
QWEN_VL_MAX_PIXELS=1003520
# Download weights into the huggingface volume, then keep them on the GPU.
QWEN_DOWNLOAD_ON_START=true
QWEN_LOAD_ON_START=true
QWEN_HOST=0.0.0.0
QWEN_PORT=8090
